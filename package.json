{
  "name": "@xinosolutions/react-datatable",
  "version": "1.2.1",
  "private": false,
  "description": "A modern, feature-rich React DataTable component with search, selection, and customizable columns",
  "type": "module",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "webpack --config webpack.config.cjs --mode production && node scripts/post-build.js",
    "build:dev": "webpack --config webpack.config.cjs --mode development && node scripts/post-build.js",
    "build:local": "npm run build",
    "deploy": "node scripts/deploy.mjs",
    "link": "node scripts/link.mjs",
    "unlink": "node scripts/unlink.mjs",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "preview": "vite preview"
  },
  "keywords": [
    "react",
    "datatable",
    "data-table",
    "table",
    "grid",
    "ui",
    "component",
    "react-component",
    "table-component",
    "data-grid"
  ],
  "author": "Xino Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xinosolutions/npm-react-datatable.git"
  },
  "bugs": {
    "url": "https://github.com/xinosolutions/npm-react-datatable/issues"
  },
  "homepage": "https://github.com/xinosolutions/npm-react-datatable#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.7.5",
    "@babel/preset-env": "^7.7.6",
    "@babel/preset-react": "^7.7.4",
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "babel-loader": "^8.0.6",
    "clean-webpack-plugin": "^3.0.0",
    "css-loader": "^3.3.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "style-loader": "^1.0.1",
    "vite": "npm:rolldown-vite@7.2.5",
    "webpack": "^4.41.2",
    "webpack-cli": "^3.3.10"
  },
  "overrides": {
